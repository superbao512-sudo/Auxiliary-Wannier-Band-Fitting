&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-5
  outdir = './tmp/'
  prefix = 'Te'
  pseudo_dir = './'
  tprnfor = .true.
  tstress = .true.
/

&SYSTEM
  ibrav = 0
  nat = 3
  ntyp = 1

  ecutwfc = 70
  ecutrho = 500

  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.001

  nbnd = 60
/

&ELECTRONS
  conv_thr = 1.0d-12
  electron_maxstep = 80
  mixing_beta = 0.4
  mixing_mode = 'plain'
  diagonalization = 'david'
/

ATOMIC_SPECIES
Te  127.60  Te_ONCV_PBE_fr.upf

